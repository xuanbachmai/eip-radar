# Optional. Raises the GitHub API limit from 60/h to 5,000/h. A sync makes 2 API calls, so it
# works without a token; `pnpm backfill` needs one.
GITHUB_TOKEN=
# Vercel Cron sends this as a Bearer token to /api/refresh.
CRON_SECRET=
# Public origin used in /feed.xml links (defaults to the request origin).
SITE_URL=
# Set to 1 to serve only the committed snapshot (no live GitHub checks). Used by CI and e2e tests.
EIP_RADAR_OFFLINE=
